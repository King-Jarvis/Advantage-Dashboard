# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Secrets are NOT set here as values — they are generated into deploy/secrets/
# by scripts/bootstrap.sh and referenced by path, so they never appear in
# `docker inspect` or /proc/<pid>/environ. Only non-secret configuration and
# the paths themselves live in this file.

# ── Where the app is reached ────────────────────────────────────────────
# Must exactly match the redirect URI registered in Google Cloud, scheme and
# all. A trailing slash mismatch is the usual cause of redirect_uri_mismatch.
BASE_URL=http://localhost:8766
DASHBOARD_PORT=8766

# Absolute path on the host for the database, uploads and logs.
# Keep this OUTSIDE the checkout — the repo is public.
DATA_ROOT=/srv/dashboard-data

# Where make-local-cert.sh wrote ca.crt / server.crt / server.key.
# Keep outside the checkout: server.key is a private key.
CERTS_DIR=/srv/dashboard-certs

TZ=UTC
LOG_LEVEL=info

# ── Google OAuth ────────────────────────────────────────────────────────
# From your Google Cloud project. The client ID is not secret; the client
# secret is, so it goes in deploy/secrets/.
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_PATH=/run/secrets/google_client_secret

# Comma-separated Google account IDs ("sub" claim) permitted to sign in.
# Empty means nobody can sign in with Google — a deliberate default, so a
# fresh deployment is never open to any Google account on the internet.
# Find yours after a first attempt: it is logged as a rejected sub.
ALLOWED_GOOGLE_SUBS=

# ── Actual Budget ───────────────────────────────────────────────────────
ACTUAL_SERVER_URL=http://actual:5006/
ACTUAL_SYNC_ID=REPLACE-sync-id-from-actual-settings-advanced
ACTUAL_PASSWORD_PATH=/run/secrets/actual_password
ACTUAL_API_KEY_PATH=/run/secrets/actual_api_key
ACTUAL_API_URL=http://actual-api:5007/

# Transactions dated BEFORE this go to local history only and never reach
# Actual; on or after it, they are pushed. Set it to the start date of your
# Actual budget file. Format YYYY-MM-DD.
ACTUAL_BUDGET_START_DATE=2026-01-01

# ── Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY_PATH=/run/secrets/anthropic_api_key
CLASSIFY_MODEL=claude-haiku-4-5
SUGGEST_MODEL=claude-haiku-4-5

# Spending analysis sends category totals per month to Anthropic. It never
# sends transactions, payees or account numbers. Off by default; turning it on
# is an explicit choice to share aggregates with a third party.
ENABLE_SPENDING_ANALYSIS=false

# ── App secrets (paths, generated by scripts/bootstrap.sh) ──────────────
INGEST_KEY_PATH=/run/secrets/ingest_key
SESSION_KEY_PATH=/run/secrets/session_key
TOKEN_KEY_PATH=/run/secrets/token_key

# ── Budget engine ───────────────────────────────────────────────────────
BASELINE_WINDOW_MONTHS=12
BASELINE_TRIM_PCT=10
MIN_MONTHS_FOR_SUGGESTION=3
