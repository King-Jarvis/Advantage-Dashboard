# ── Secrets ─────────────────────────────────────────────────────────────
# Everything under deploy/secrets/ is generated by scripts/bootstrap.sh and
# must never be committed. The .gitkeep is the sole exception.
deploy/secrets/*
!deploy/secrets/.gitkeep
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*_secret
*_secret.*
credentials.json
client_secret*.json

# ── Local deployment overrides (host-specific: ports, paths, hostnames) ──
deploy/compose.override.yml
docker-compose.override.yml

# ── Data — never in the repo ────────────────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.log

# ── Statements and financial exports ────────────────────────────────────
# Belt and braces: these should live outside the checkout entirely, but a
# stray download into the repo must not become a public commit.
*.ofx
*.qfx
*.csv
!tests/fixtures/**/*.csv
statements/

# ── n8n raw exports (may embed credential ids, webhook uuids, hostnames) ─
# Only scrubbed exports produced by scripts/scrub-workflows.py are tracked.
n8n/raw/

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── OS / editor ─────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
